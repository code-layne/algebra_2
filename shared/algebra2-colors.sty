\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algebra2-colors}[2026/06/01 Algebra 2 shared color palette]

\RequirePackage{xcolor}

% ── Primary palette — forest-green based ──────────────────────────────────────
% forest is the course's primary accent (frames, page headers, banners, titles);
% forestbg is its pale companion background.
\definecolor{forest}{HTML}{1E5631}
\definecolor{forestlight}{HTML}{2E7D46}
\definecolor{forestbg}{HTML}{EAF5EE}
\definecolor{forestmid}{HTML}{C6E5D1}

% ── Navy family — secondary accent (vocabulary & related boxes) ───────────────
\definecolor{navy}{HTML}{1F3A5F}
\definecolor{navylight}{HTML}{2E5490}
\definecolor{sky}{HTML}{EAF3FB}
\definecolor{skymid}{HTML}{C5DFF5}

% ── Accent families ───────────────────────────────────────────────────────────
\definecolor{goldacc}{HTML}{D4820A}
\definecolor{goldbg}{HTML}{FEF3E2}
\definecolor{hookbg}{HTML}{FEF3E2}
\definecolor{greenbg}{HTML}{EDF8F0}
\definecolor{greenacc}{HTML}{2D7A4F}
\definecolor{redbg}{HTML}{FCECEC}
\definecolor{redacc}{HTML}{C0392B}
\definecolor{charcoal}{HTML}{2C3E50}
\definecolor{slate}{HTML}{64748B}
\definecolor{linegray}{HTML}{AAAAAA}
\definecolor{keyred}{HTML}{CC0000}

% ── Lesson-plan background aliases ────────────────────────────────────────────
\definecolor{goldbox}{HTML}{FFF7E6}
\colorlet{greenbox}{greenbg}
\colorlet{redbox}{redbg}
\colorlet{forestbox}{forestbg}
