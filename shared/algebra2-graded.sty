\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algebra2-graded}[2026/10/22 Algebra 2 graded boxes in an existing layout]

% Placement helpers for converting an already-authored component to
% math-shared's \gradedblank (grading.sty) without moving a single line or page
% break. Load it after grading, in the blank and the key alike:
%
%   \usepackage{grading}
%   \gradingassignment{alg2-u01-l04-hw}
%   \gradingcourse{algebra_2}
%   \usepackage{algebra2-graded}
%
% Each helper typesets the material the component used to print in invisible
% form (or, for write lines, unchanged), so the line costs exactly what it did,
% and lays the \gradedblank over it with zero width, height and depth. The box
% is still recorded where it is actually drawn (zref-savepos), so the manifest
% positions are the printed ones. Every helper is written identically in the
% blank and the key; the key prints its answer inside the box.

\RequirePackage{pgf}

% ── Positions inside tcolorbox (XeTeX) ───────────────────────────────────────
% tcolorbox draws its content with \pgftext, which the xdvipdfmx driver of pgf
% places with a "pdf:btrans" translation special. TeX never sees that
% translation, so a \zsavepos inside a tcolorbox -- every \gradedblank in a
% notesbox -- is recorded at the wrong place (off by the box's padding and title
% height). When the transformation is a pure translation, as it is for every
% tcolorbox in this course, make the same move with TeX's own \hskip and
% \raise instead: the page renders identically and the recorded positions are
% the printed ones. Anything rotated or scaled keeps pgf's original code.
\def\alg@pgf@translated#1{%
  \pgfsys@begin@idscope
  \pgfsys@beginscope
    \setbox#1=\hbox{\box#1}%
    \wd#1=0pt\ht#1=0pt\dp#1=0pt
    \pgfsys@dvipdfmx@suspendcontent
    \pgfsys@invoke{0 J [] 0 d}%
    \pgfsys@dvipdfmx@start@force@reset@color
    \hskip\pgf@pt@x\raise\pgf@pt@y\box#1\hskip-\pgf@pt@x
    \pgfsys@dvipdfmx@stop@force@reset@color
    \pgfsys@dvipdfmx@unsuspendcontent
  \pgfsys@endscope
  \pgfsys@end@idscope}
\newif\ifalg@pgfshift
\@ifundefined{pgfsys@dvipdfmx@suspendcontent}{}{%
  \let\alg@pgf@hboxsynced@orig\pgfsys@hboxsynced
  \def\pgfsys@hboxsynced#1{%
    \alg@pgfshiftfalse
    \ifdim\pgf@pt@aa pt=1pt \ifdim\pgf@pt@bb pt=1pt
      \ifdim\pgf@pt@ab pt=0pt \ifdim\pgf@pt@ba pt=0pt
        \alg@pgfshifttrue
      \fi\fi
    \fi\fi
    \ifalg@pgfshift\alg@pgf@translated{#1}\else\alg@pgf@hboxsynced@orig{#1}\fi}}

% ── Work blocks stay with their prompt and their answer ──────────────────────
% In a graded component a \begin{work} block (algebra2-boxes) is glued to the
% line before it and the line after it: no page break between a prompt and its
% work space, or between the work space and the answer box under it.
\RequirePackage{etoolbox}
\AtBeginDocument{%
  \@ifundefined{work}{}{%
    \patchcmd{\work}{\par\addvspace{\abovedisplayskip}}
      {\par\nobreak\addvspace{\abovedisplayskip}}{}
      {\PackageWarning{algebra2-graded}{could not patch work (start)}}%
    \patchcmd{\endwork}{\par\addvspace{\belowdisplayskip}}
      {\par\nobreak\addvspace{\belowdisplayskip}}{}
      {\PackageWarning{algebra2-graded}{could not patch work (end)}}}}

% \begin{keepwithprompt} ... \end{keepwithprompt}
%   Around the figure, table or list that follows an item's lead-in: no page
%   break between the lead-in and its start, or right after its end. (\boxguard
%   cannot do this inside a breakable notesbox, and a center or list
%   environment otherwise invites a break just before and after itself.)
%   Breaks inside a list, between its items, stay.
\newenvironment{keepwithprompt}{\par\nobreak\@beginparpenalty\@M\@endparpenalty\@M}{\par}

% \inblank{<old blank>}{<\gradedblank ...>}
%   The box replaces an answer blank on a text line: \blank{1.1cm}, a test's
%   \slot{2.4cm}{answer}, or anything else the student wrote on. The old blank
%   is set as a \phantom (its width, height and depth, so the line keeps its
%   metrics in both files) and the box is laid over it, centred. Give the box
%   the blank's width less 2pt, {1.1cm-2pt}, so it never touches punctuation
%   set right against the blank. The box keeps its height and depth: a short
%   box fits inside the line anyway, and a box taller than the line (a square
%   choice box) opens the line up instead of running into its neighbours.
%   A rubric box never goes in a blank: use \rubricbox.
\newsavebox{\alg@gradedbox}
\newsavebox{\alg@answerbox}
% \alg@clearance{<box register>}: a box taller than a text line (a square
% choice box) gets \gradedboxclearance of extra room above and below, so the
% lines around it never touch its border. A box that fits in the line adds
% nothing.
\newlength{\gradedboxclearance}\setlength{\gradedboxclearance}{2.5pt}
% Its paragraph also keeps its first two and last three lines together
% (\clubpenalties, \widowpenalties; set globally, since the box may sit in an
% \llap), so a choice item's stem and options do not split at a page.
\newcommand{\alg@clearance}[1]{%
  \ifdim\dimexpr\ht#1+\dp#1\relax>\baselineskip
    \ifhmode\global\widowpenalties 4 \@M \@M \@M 150\relax
      \global\clubpenalties 3 \@M \@M 150\relax\fi
    \vrule width\z@ height\dimexpr\ht#1+\gradedboxclearance\relax
      depth\dimexpr\dp#1+\gradedboxclearance\relax
  \fi}
\newcommand{\inblank}[2]{%
  \leavevmode\sbox{\alg@gradedbox}{#1}%
  \sbox{\alg@answerbox}{#2}%
  \alg@clearance{\alg@answerbox}%
  \rlap{\makebox[\wd\alg@gradedbox]{\usebox{\alg@answerbox}}}\phantom{#1}}

% \letterbox{<\gradedblank ...>}
%   A multiple-choice answer: "Letter:" and a box, set flush with the right
%   edge of the current line (\linewidth), with zero width. Put it at the start
%   of a line whose right end is empty (an answer-option line, or the stem's
%   line). math-shared draws every choice box square, taller than a text line,
%   so the box keeps its height and depth and the line opens up around it.
% \answerbox[<label>]{<\gradedblank ...>}
%   The same for any final answer, labelled "Answer:" unless a label is given.
\newcommand{\answerbox}[2][Answer:]{%
  \leavevmode
  \sbox{\alg@gradedbox}{\small\textbf{#1}\ #2}%
  \alg@clearance{\alg@gradedbox}%
  \rlap{\hskip\dimexpr\linewidth-\wd\alg@gradedbox\relax\usebox{\alg@gradedbox}}}
\newcommand{\letterbox}[1]{\answerbox[Letter:]{#1}}
% \choicebox{<\gradedblank ...>}
%   A box set by hand (in the margin, after a stem), at its full size: the box
%   and \alg@clearance, nothing else. Wrap it in \llap or \rlap as before.
\newcommand{\choicebox}[1]{%
  \sbox{\alg@answerbox}{#1}\alg@clearance{\alg@answerbox}\usebox{\alg@answerbox}}

% Work areas that are only vertical space (\vspace{2.5cm} after a prompt).
% \workanswer goes between paragraphs and costs no vertical space at all: the
% material hangs in a box of zero height, and the following line is spaced as
% if the box were not there.
%
% \workanswer[<label>]{<\gradedblank ...>}
%   Right AFTER the work area's \vspace: "Answer:" and the box, flush right,
%   their bottom edge \gradedworkgap above the end of the space.
\newlength{\gradedworkgap}
\setlength{\gradedworkgap}{3pt}
\newcommand{\alg@zeroheight}[1]{%
  \par
  \edef\alg@prevdepth{\the\prevdepth}%
  \nointerlineskip
  \moveright\@totalleftmargin\vbox to\z@{#1}%
  \prevdepth=\alg@prevdepth\relax}
\newcommand{\workanswer}[2][Answer:]{%
  \sbox{\alg@gradedbox}{\raisebox{0pt}[0pt][0pt]{\small\textbf{#1}\ #2}}%
  \alg@zeroheight{\vss
    \hbox to\linewidth{\hfill\usebox{\alg@gradedbox}}%
    \kern\dimexpr\gradedworkgap+0.6em\relax}}

% ── Rubric boxes ─────────────────────────────────────────────────────────────
% math-shared draws every rubric box at least \gradingrubricminheight (2in)
% tall, so a written response never shares a text line or sits over write
% lines: it gets its own full-width box under its prompt, and the box takes
% real space on the page.
%
% \rubricbox{<\gradedblank[..., type=rubric]{\linewidth}{<h>}>}
%   Right after the prompt. In a paragraph, the box goes directly under the
%   line the command ends up on (a \vadjust: no page break can come between
%   that line and the box), and the paragraph goes on after it, so a following
%   \\[3pt] or (b) works as before. Between paragraphs, it is a block of its
%   own, kept with the paragraph above. Either way the block is the box's drawn
%   height plus \gradedrubrictop above and \gradedrubricbottom below.
% \workarea{<\gradedblank ...>}
%   The same block, for a test's free-response space. It replaces the old
%   pair \vadjust{\workarea{...}}\vspace{<space>}: the box is the space now.
% \gradedlines{<n>}{<\gradedblank[...]{\linewidth}{\gradedlinesheight}>}
%   The old explain / justify helper, kept so a call written for it still
%   works: \gradedlinesheight is set to the height of n write lines, and the
%   box (at least 2in tall) follows the prompt as a \rubricbox, with the
%   paragraph ended after it.
\newlength{\gradedrubrictop}\setlength{\gradedrubrictop}{4pt}
\newlength{\gradedrubricbottom}\setlength{\gradedrubricbottom}{6pt}
\newcommand{\alg@rubricblock}[1]{%
  \sbox{\alg@gradedbox}{#1}%
  \moveright\@totalleftmargin\vbox{%
    \kern\gradedrubrictop
    \hbox to\linewidth{\raisebox{-\height}{\usebox{\alg@gradedbox}}\hss}%
    \kern\gradedrubricbottom}}
% In a paragraph, its first two and last three lines are kept together as well
% (\clubpenalties, \widowpenalties, read when the paragraph ends), so the end
% of the prompt never stays behind on the page before its box. The setting
% outlasts the paragraph only as that keep-together rule, which is harmless.
\newcommand{\rubricbox}[1]{%
  \ifhmode
    \widowpenalties 4 \@M \@M \@M 150\relax
    \clubpenalties 3 \@M \@M 150\relax
    \vadjust{\alg@rubricblock{#1}}%
  \else
    \nobreak\alg@rubricblock{#1}%
  \fi}
\newcommand{\workarea}[1]{\rubricbox{#1}}
\newlength{\gradedlinesheight}
\newcommand{\gradedlines}[2]{%
  \setlength{\gradedlinesheight}{\dimexpr(\baselineskip+4pt)*\numexpr#1\relax-1pt\relax}%
  \rubricbox{#2}\ifhmode\par\fi}

\endinput
