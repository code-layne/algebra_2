\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algebra2-beamer}[2026/06/01 Algebra 2 Beamer setup]

\RequirePackage{algebra2-colors}
\RequirePackage{tikz}
\RequirePackage{amsmath,amssymb}
\RequirePackage{multicol}
\RequirePackage{array}
\RequirePackage{tabularx}

% Beamer overrides — brighter values needed for dark-background slides
\definecolor{goldacc}{HTML}{F5A623}
\definecolor{hookbg}{HTML}{D4820A}

% ── Theme ─────────────────────────────────────────────────────────────────────
\usetheme{default}
\usecolortheme{default}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{headline}{}
\setbeamercolor{normal text}{fg=charcoal}
\setbeamerfont{normal text}{family=\sffamily}

% ── \forestheader{Title} ────────────────────────────────────────────────────────
% Full-width forest bar across the top of a slide with white title text.
\newcommand{\forestheader}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[forest] (current page.north west)
      rectangle ([yshift=-1.35cm]current page.north east);
    \node[anchor=west, text=white, font=\bfseries\large,
          inner xsep=0.55cm, inner ysep=0pt]
      at ([yshift=-0.68cm]current page.north west) {#1};
  \end{tikzpicture}%
  \vspace{1.05cm}\par}

% ── \sectionlabel[color]{LABEL TEXT} ─────────────────────────────────────────
% Small-caps section label above slide content.
\newcommand{\sectionlabel}[2][forest]{%
  {\color{#1}\bfseries\footnotesize\MakeUppercase{#2}}\par\smallskip}

% ── \reveal[n]{answer} ────────────────────────────────────────────────────────
% A "Now you try" answer (or a warm-up answer): hidden on the projector until
% overlay n (default 2, i.e. the first click) and dropped entirely from the
% printed handout, which shared/lesson.mk compiles in Beamer's handout mode —
% the student's copy shows the problem and the notes column to work it in,
% never the answer. \uncover keeps the space reserved, so nothing jumps.
\newcommand{\reveal}[2][2]{\uncover<#1-| handout:0>{#2}}
